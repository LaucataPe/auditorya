DATABASE_URL=postgresql://user:pass@localhost:5432/auditorya
REDIS_URL=redis://localhost:6379
JWT_SECRET=cambia_esto_en_produccion
# IA vía OpenRouter (compatible con OpenAI). Sin la key, la IA queda deshabilitada (fallback estático).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # opcional (default)
# OPENROUTER_SITE_URL=https://auditorya.app          # opcional (atribución)
S3_BUCKET=auditorya-evidencia
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FRONTEND_URL=http://localhost:5173
PORT=3001

# Almacenamiento de archivos de evidencia: 'local' (disco) o 's3' (pendiente de activar)
STORAGE_DRIVER=local
STORAGE_DIR=./data/archivos

# Lectura de formularios DIAN (300 IVA / 350 retefuente) por workflow propio.
# Si está, se prefiere sobre el LLM; si falla, cae al LLM cuando hay OPENROUTER_API_KEY.
N8N_DECLARACION_URL=https://n8n-n8n.cohvyw.easypanel.host/webhook/declaracion-dian
# N8N_DECLARACION_TOKEN=            # opcional (Bearer)
